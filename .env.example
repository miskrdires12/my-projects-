# Database (SQLite default for initial setup, PostgreSQL-ready)
DATABASE_URL="file:./dev.db"

# Cryptographic Session & JWT Secret (minimum 32 characters)
AUTH_SECRET="replace-with-a-secure-random-32-character-secret-in-production"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="production"
